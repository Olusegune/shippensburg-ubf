---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Accessibility">
  <PageHeader title="Accessibility Statement" />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-stone-700">
      This site targets WCAG 2.2 AA. If you encounter an accessibility barrier, please
      <a class="text-maroon-800 underline" href="/contact/">contact us</a> and we'll address it.
    </p>
  </div>
</BaseLayout>
