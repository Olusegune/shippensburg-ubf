---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accessibility">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Accessibility Statement</h1>
    <p class="mt-4 text-stone-700">
      This site targets WCAG 2.2 AA. If you encounter an accessibility barrier, please
      <a class="text-emerald-900 underline" href="/contact/">contact us</a> and we'll address it.
    </p>
  </div>
</BaseLayout>
