---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="font-serif text-6xl font-semibold text-maroon-800">404</p>
    <h1 class="mt-4 font-serif text-2xl font-semibold text-maroon-800">Page Not Found</h1>
    <p class="mt-3 text-stone-700">
      The page you're looking for may have moved. Try searching, or head back to the homepage.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-md bg-maroon-700 px-6 py-3 font-semibold text-white hover:bg-maroon-600">
        Go Home
      </a>
      <a href="/search/" class="rounded-md border border-maroon-700 px-6 py-3 font-semibold text-maroon-800 hover:bg-maroon-50">
        Search the Site
      </a>
    </div>
    <p class="mt-8 text-sm text-stone-500">
      Looking for a Bible study document? Try <a class="underline" href="/resources/books/">browsing by book</a>.
    </p>
  </div>
</BaseLayout>
