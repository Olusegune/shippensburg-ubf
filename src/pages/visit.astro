---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
---

<BaseLayout title="Visit">
  <PageHeader title="Plan Your Visit" subtitle="We'd love to have you join us" />

  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="flex items-start gap-4 rounded-lg border border-cream-200 bg-white p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-6 w-6 shrink-0 text-maroon-700" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
        <div>
          <h2 class="font-semibold text-stone-800">Sunday Worship</h2>
          <p class="mt-1 text-stone-600">{settings?.data.worshipTime}<br />{settings?.data.worshipLocation}</p>
        </div>
      </div>
      <div class="flex items-start gap-4 rounded-lg border border-cream-200 bg-white p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-6 w-6 shrink-0 text-maroon-700" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <div>
          <h2 class="font-semibold text-stone-800">Weekly Fellowship</h2>
          <p class="mt-1 text-stone-600">{settings?.data.fellowshipTime}<br />{settings?.data.fellowshipLocation}</p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-start gap-4 rounded-lg border border-cream-200 bg-white p-5">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-6 w-6 shrink-0 text-maroon-700" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <h2 class="font-semibold text-stone-800">Location</h2>
        <p class="mt-1 text-stone-600">{settings?.data.address}</p>
        <a href={settings?.data.mapUrl} rel="external noopener" class="mt-2 inline-block font-medium text-maroon-800 underline underline-offset-2">Get Directions &rarr;</a>
      </div>
    </div>

    <div class="mt-8 rounded-lg bg-cream-100 p-6 text-center">
      <p class="font-serif text-lg text-maroon-800">First time visiting?</p>
      <p class="mt-1 text-sm text-stone-600">No previous Bible knowledge is needed — come as you are.</p>
      <a href="/students/one-to-one-bible-study/" class="mt-4 inline-block rounded-md bg-maroon-700 px-6 py-3 font-semibold text-white hover:bg-maroon-600">
        Request Bible Study
      </a>
    </div>
  </div>
</BaseLayout>
