---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const faqs = [
  { q: 'Who may attend?', a: 'Anyone! Students of any background or belief are welcome — no previous Bible knowledge required.' },
  { q: 'What is one-to-one Bible study like?', a: 'A relaxed, personal conversation through a passage of Scripture with a study leader — no pressure, just honest discussion.' },
  { q: 'What happens at worship?', a: 'Singing, prayer, and a message from the Bible, followed by fellowship together.' },
  { q: 'How do I make contact?', a: 'Send a Bible study request below, or just show up to Sunday worship or Thursday fellowship — we\'d love to meet you.' },
];
---

<BaseLayout title="Students">
  <PageHeader title="For Students" subtitle="A warm, low-pressure place to explore faith and grow" />

  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="grid gap-4 sm:grid-cols-2">
      {faqs.map((faq) => (
        <div class="rounded-lg border border-cream-200 bg-white p-5">
          <h2 class="font-semibold text-maroon-800">{faq.q}</h2>
          <p class="mt-2 text-sm text-stone-600">{faq.a}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-lg bg-cream-100 p-6 text-center">
      <p class="font-serif text-lg text-maroon-800">Would you like to study the Bible with someone?</p>
      <a href="/students/one-to-one-bible-study/" class="mt-4 inline-block rounded-md bg-maroon-700 px-6 py-3 font-semibold text-white hover:bg-maroon-600">
        Request Bible Study
      </a>
    </div>
  </div>
</BaseLayout>
