---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Students">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">For Students</h1>
    <p class="mt-4 text-stone-700">
      Anyone is welcome to attend, no previous Bible knowledge required. Learn what to expect at worship
      and one-to-one Bible study, and how to make contact.
    </p>
    <a href="/students/one-to-one-bible-study/" class="mt-4 inline-block rounded-md bg-emerald-900 px-6 py-3 font-semibold text-white">
      Request Bible Study
    </a>
  </div>
</BaseLayout>
