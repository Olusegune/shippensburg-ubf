---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Request Bible Study">
  <div class="mx-auto max-w-xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Request Bible Study</h1>
    <p class="mt-2 text-stone-700">Would you like to study the Bible with someone? Fill out the form below and a leader will follow up.</p>

    <form name="bible-study-request" method="POST" data-netlify="true" class="mt-6 space-y-5">
      <input type="hidden" name="form-name" value="bible-study-request" />
      <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div>
        <label for="name" class="block text-sm font-medium text-stone-700">Name</label>
        <input id="name" name="name" type="text" required class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2" />
      </div>

      <div>
        <label for="contact" class="block text-sm font-medium text-stone-700">Email or preferred contact</label>
        <input id="contact" name="contact" type="text" required class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2" />
      </div>

      <div>
        <label for="studentStatus" class="block text-sm font-medium text-stone-700">Student status (optional)</label>
        <input id="studentStatus" name="studentStatus" type="text" class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2" />
      </div>

      <fieldset>
        <legend class="text-sm font-medium text-stone-700">Preferred meeting format</legend>
        <div class="mt-1 flex gap-4 text-sm">
          <label><input type="radio" name="meetingFormat" value="in-person" required /> In person</label>
          <label><input type="radio" name="meetingFormat" value="online" /> Online</label>
        </div>
      </fieldset>

      <div>
        <label for="message" class="block text-sm font-medium text-stone-700">Message</label>
        <textarea id="message" name="message" rows="4" class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2"></textarea>
      </div>

      <div class="flex items-start gap-2">
        <input id="consent" name="consent" type="checkbox" required class="mt-1" />
        <label for="consent" class="text-sm text-stone-700">I consent to being contacted about this request.</label>
      </div>

      <button type="submit" class="rounded-md bg-emerald-900 px-6 py-3 font-semibold text-white">Submit Request</button>
    </form>
  </div>
</BaseLayout>
