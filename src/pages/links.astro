---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const links = [
  { title: 'World Mission', href: 'http://www.ubf.org/worldmission/', description: 'UBF\'s worldwide mission work.', external: true },
  { title: 'Daily Bread', href: '/bible-study/daily-bread/', description: 'Today\'s devotional Bible reading, prayer, and reflection.', external: false },
  { title: 'Global UBF', href: 'https://ubf.org', description: 'University Bible Fellowship international.', external: true },
];
---

<BaseLayout title="Links">
  <PageHeader title="Links" subtitle="External resources related to our ministry and the wider UBF community" />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <ul class="mt-6 space-y-3">
      {links.map((link) => (
        <li class="rounded-lg border border-cream-200 bg-white p-4">
          <a href={link.href} rel={link.external ? 'external noopener' : undefined} class="font-semibold text-maroon-800 underline underline-offset-2">{link.title}</a>
          <p class="mt-1 text-sm text-stone-600">{link.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
