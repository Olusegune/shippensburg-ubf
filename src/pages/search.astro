---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Search</h1>
    <p class="mt-2 text-stone-700">Search Bible study questions, messages, and site pages by title, passage, or keyword.</p>

    <div class="mt-6">
      <label for="search-input" class="sr-only">Search</label>
      <input
        id="search-input"
        type="search"
        placeholder="Search by title, passage, or keyword…"
        class="w-full rounded-md border border-stone-300 px-4 py-3 text-lg"
        autocomplete="off"
      />
    </div>

    <p id="search-status" class="mt-3 text-sm text-stone-500" role="status" aria-live="polite"></p>

    <ul id="search-results" class="mt-4 space-y-4"></ul>
  </div>
</BaseLayout>

<script is:inline type="module">
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');

  let pagefind;
  let debounceTimer;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      status.textContent = 'Search index not found. Run "npm run build" to generate it (search only works on a built site, not in dev mode).';
    }
    return pagefind;
  }

  function renderResult(data) {
    const li = document.createElement('li');
    li.className = 'rounded-lg border border-stone-200 bg-white p-4';
    const link = document.createElement('a');
    link.href = data.url;
    link.className = 'font-semibold text-emerald-900';
    link.textContent = data.meta?.title ?? data.url;
    const excerpt = document.createElement('p');
    excerpt.className = 'mt-1 text-sm text-stone-600';
    excerpt.innerHTML = data.excerpt;
    li.append(link, excerpt);
    return li;
  }

  async function runSearch(term) {
    if (!term) {
      results.innerHTML = '';
      status.textContent = '';
      return;
    }
    const pf = await loadPagefind();
    if (!pf) return;

    status.textContent = 'Searching…';
    const search = await pf.search(term);
    results.innerHTML = '';

    if (search.results.length === 0) {
      status.textContent = `No results for "${term}". Try a different spelling, or fewer words.`;
      return;
    }

    status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'}`;
    const items = await Promise.all(search.results.slice(0, 30).map((r) => r.data()));
    for (const item of items) {
      results.appendChild(renderResult(item));
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const term = input.value.trim();
    debounceTimer = setTimeout(() => runSearch(term), 250);
  });

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  if (initialQuery) {
    input.value = initialQuery;
    runSearch(initialQuery);
  }

  loadPagefind();
</script>
