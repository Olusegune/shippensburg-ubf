---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getCollection } from 'astro:content';

const resources = (await getCollection('resources', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.book.localeCompare(b.data.book));
---

<BaseLayout title="Resource Library" description="Search hundreds of Bible study questions and messages by book, passage, or topic.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Resource Library</h1>
    <p class="mt-2 max-w-2xl text-stone-700">
      Browse study questions and messages by Bible book, testament, or topic.
    </p>

    <div class="mt-4 flex gap-3">
      <a href="/resources/books/" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium">Browse by Book</a>
      <a href="/resources/series/" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium">Browse by Series</a>
    </div>

    <p class="mt-6 text-sm text-stone-500">{resources.length} resource{resources.length === 1 ? '' : 's'}</p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {resources.map((resource) => <ResourceCard resource={resource} />)}
    </div>
  </div>
</BaseLayout>
