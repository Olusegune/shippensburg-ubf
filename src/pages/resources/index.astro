---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getCollection } from 'astro:content';
import { BIBLE_BOOKS } from '../../content.config';

const bookRank = new Map(BIBLE_BOOKS.map((book, i) => [book, i]));

function sortResources(list: Awaited<ReturnType<typeof getCollection<'resources'>>>) {
  return list.sort((a, b) => {
    const rankDiff = (bookRank.get(a.data.book) ?? 999) - (bookRank.get(b.data.book) ?? 999);
    if (rankDiff !== 0) return rankDiff;
    return (a.data.lessonNumber ?? 0) - (b.data.lessonNumber ?? 0);
  });
}

const allPublished = await getCollection('resources', ({ data }) => data.status === 'published');
const oldTestament = sortResources(allPublished.filter((r) => r.data.testament === 'old'));
const newTestament = sortResources(allPublished.filter((r) => r.data.testament === 'new'));
---

<BaseLayout title="Resource Library" description="Search hundreds of Bible study questions and messages by book, passage, or topic.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-maroon-800">Resource Library</h1>
    <p class="mt-2 max-w-2xl text-stone-700">
      Browse study questions and messages by Bible book, testament, or topic.
    </p>

    <div class="mt-4 flex gap-3">
      <a href="/resources/books/" class="rounded-md border border-maroon-800/30 px-4 py-2 text-sm font-medium text-maroon-800">Browse by Book</a>
      <a href="/search/" class="rounded-md border border-maroon-800/30 px-4 py-2 text-sm font-medium text-maroon-800">Search</a>
    </div>

    <p class="mt-6 text-sm text-stone-500">{allPublished.length} resource{allPublished.length === 1 ? '' : 's'}</p>

    {[
      { label: 'Old Testament', items: oldTestament },
      { label: 'New Testament', items: newTestament },
    ].map(({ label, items }) => items.length > 0 && (
      <section class="mt-8">
        <h2 class="border-b border-cream-200 pb-2 font-serif text-2xl font-semibold text-maroon-800">{label}</h2>
        <p class="mt-1 text-sm text-stone-500">{items.length} resource{items.length === 1 ? '' : 's'}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((resource) => <ResourceCard resource={resource} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
