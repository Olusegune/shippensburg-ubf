---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { BIBLE_BOOKS } from '../../../content.config';

const resources = await getCollection('resources', ({ data }) => data.status === 'published');
const counts = new Map<string, number>();
for (const r of resources) counts.set(r.data.book, (counts.get(r.data.book) ?? 0) + 1);

const oldTestament = BIBLE_BOOKS.slice(0, 39);
const newTestament = BIBLE_BOOKS.slice(39);

function slugify(book: string) {
  return book.toLowerCase().replace(/\s+/g, '-');
}
---

<BaseLayout title="Books of the Bible">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-maroon-800">Books of the Bible</h1>
    <p class="mt-2 text-stone-700">All 66 books are listed. Books without resources yet are shown disabled rather than omitted.</p>

    {[['Old Testament', oldTestament], ['New Testament', newTestament]].map(([label, books]) => (
      <section class="mt-8">
        <h2 class="font-serif text-xl font-semibold text-maroon-800">{label}</h2>
        <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
          {(books as string[]).map((book) => {
            const count = counts.get(book) ?? 0;
            return (
              <li>
                {count > 0 ? (
                  <a href={`/resources/books/${slugify(book)}/`} class="block rounded-md border border-cream-200 bg-white px-3 py-2 text-sm hover:border-maroon-800">
                    {book} <span class="text-stone-400">({count})</span>
                  </a>
                ) : (
                  <span class="block rounded-md border border-stone-100 bg-cream-100 px-3 py-2 text-sm text-stone-400" aria-disabled="true">
                    {book}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
