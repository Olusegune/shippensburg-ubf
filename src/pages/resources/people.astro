---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const people = await getCollection('people');
const leaders = people.filter((p) => p.data.role.includes('leader'));
const characters = people.filter((p) => p.data.role.includes('character'));
---

<BaseLayout title="Spiritual Leaders & Biblical Figures">
  <PageHeader title="Spiritual Leaders & Biblical Figures" />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-stone-700">
      Archived from the legacy site. These write-ups are pending author/licensing confirmation with the
      ministry and are not yet published in full — each links to the original file for now.
    </p>

    <h2 class="mt-8 font-serif text-xl font-semibold text-maroon-800">Historical Spiritual Leaders</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {leaders.map((p) => <li class="rounded-md border border-cream-200 bg-white px-3 py-2 text-sm">{p.data.name}</li>)}
    </ul>

    <h2 class="mt-8 font-serif text-xl font-semibold text-maroon-800">Biblical Character Studies</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {characters.map((p) => <li class="rounded-md border border-cream-200 bg-white px-3 py-2 text-sm">{p.data.name}</li>)}
    </ul>
  </div>
</BaseLayout>
