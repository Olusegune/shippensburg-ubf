---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="Start Here">
  <PageHeader title="Start Here" subtitle="New to Bible study? This is the place to begin." />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-stone-700">
      New to Bible study? The nine-step series is a guided introduction pairing study questions with a message
      for each lesson.
    </p>
    <a href="/bible-study/nine-step-study/" class="mt-4 inline-block rounded-md bg-maroon-800 px-6 py-3 font-semibold text-white">
      Begin the Nine-Step Study
    </a>
  </div>
</BaseLayout>
