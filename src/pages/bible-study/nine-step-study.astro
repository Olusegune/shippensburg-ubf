---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('resources', ({ data }) => data.series === 'nine-step-study' && data.status === 'published'))
  .sort((a, b) => (a.data.lessonNumber ?? 0) - (b.data.lessonNumber ?? 0));
---

<BaseLayout title="Nine-Step Bible Study">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Nine-Step Bible Study</h1>
    <p class="mt-2 text-stone-700">A guided introductory study series pairing study questions with a message for each lesson.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {lessons.map((lesson) => <ResourceCard resource={lesson} />)}
    </div>
  </div>
</BaseLayout>
