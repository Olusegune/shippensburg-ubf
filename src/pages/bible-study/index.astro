---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources', ({ data }) => data.status === 'published');
const questionCount = resources.filter((r) => r.data.resourceType === 'study-questions').length;
---

<BaseLayout title="Bible Study">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="font-serif text-3xl font-semibold text-emerald-900">Bible Study</h1>
    <p class="mt-2 max-w-2xl text-stone-700">
      Whether you're new to the Bible or looking to study a specific book in depth, there's a place to start.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <a href="/bible-study/start-here/" class="rounded-lg border border-stone-200 bg-white p-5 hover:border-emerald-900">
        <h2 class="font-semibold text-emerald-900">Start Here</h2>
        <p class="mt-2 text-sm text-stone-600">New to Bible study? Learn what one-to-one study looks like and how to begin.</p>
      </a>
      <a href="/bible-study/nine-step-study/" class="rounded-lg border border-stone-200 bg-white p-5 hover:border-emerald-900">
        <h2 class="font-semibold text-emerald-900">Nine-Step Bible Study</h2>
        <p class="mt-2 text-sm text-stone-600">A guided introductory series through John and Genesis.</p>
      </a>
      <a href="/resources/books/" class="rounded-lg border border-stone-200 bg-white p-5 hover:border-emerald-900">
        <h2 class="font-semibold text-emerald-900">Study a Book of the Bible</h2>
        <p class="mt-2 text-sm text-stone-600">Browse {questionCount} study-question resources across the Old and New Testament.</p>
      </a>
      <a href="/resources/" class="rounded-lg border border-stone-200 bg-white p-5 hover:border-emerald-900">
        <h2 class="font-semibold text-emerald-900">All Resources</h2>
        <p class="mt-2 text-sm text-stone-600">Search the full resource library by title, passage, or keyword.</p>
      </a>
    </div>
  </div>
</BaseLayout>
