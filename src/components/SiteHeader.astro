---
import Logo from './Logo.astro';

const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Students', href: '/students/' },
  { label: 'Bible Study', href: '/bible-study/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Events', href: '/events/' },
  { label: 'Visit', href: '/visit/' },
  { label: 'Links', href: '/links/' },
];
---

<header class="sticky top-0 z-40 bg-maroon-900">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <Logo variant="light" />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-5 text-sm font-medium text-cream-100">
        {navItems.map((item) => (
          <li><a class="hover:text-gold-400" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href="/search/" aria-label="Search" class="rounded-md p-2 text-cream-100 hover:bg-maroon-800 hover:text-gold-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <a
        href="/students/one-to-one-bible-study/"
        class="rounded-md bg-gold-500 px-4 py-2 text-sm font-semibold text-maroon-950 hover:bg-gold-400"
      >
        Request Bible Study
      </a>
    </div>

    <button
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden inline-flex items-center rounded-md border border-cream-100/40 px-3 py-2 text-sm text-cream-100"
      data-mobile-menu-trigger
    >
      Menu
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-maroon-800 lg:hidden" data-mobile-menu>
    <ul class="flex flex-col gap-1 px-4 py-3 text-sm font-medium text-cream-100">
      {navItems.map((item) => (
        <li><a class="block py-2" href={item.href}>{item.label}</a></li>
      ))}
      <li><a class="block py-2" href="/search/">Search</a></li>
      <li>
        <a class="mt-2 block rounded-md bg-gold-500 px-4 py-2 text-center font-semibold text-maroon-950" href="/students/one-to-one-bible-study/">
          Request Bible Study
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const trigger = document.querySelector('[data-mobile-menu-trigger]');
  const menu = document.querySelector('[data-mobile-menu]');
  trigger?.addEventListener('click', () => {
    const expanded = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
