---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="bg-maroon-900 py-10 text-center text-white">
  <div class="mx-auto max-w-3xl px-4">
    <h1 class="font-serif text-3xl font-semibold sm:text-4xl">{title}</h1>
    {subtitle && <p class="mt-2 text-cream-100/90">{subtitle}</p>}
  </div>
</div>
