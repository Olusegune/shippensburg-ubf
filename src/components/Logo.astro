---
// UBF's real worldwide mark (src/assets/images/ubf-mark.png, cropped from the
// official banner) on a white badge chip so it reads cleanly against the
// chapter's maroon/gold palette. See dev_spec.md for the design rationale.
import { Image } from 'astro:assets';
import ubfMark from '../assets/images/ubf-mark.png';

interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'dark' } = Astro.props;
const isLight = variant === 'light';
---

<a href="/" class="flex items-center gap-3">
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white p-1.5 shadow-sm">
    <Image src={ubfMark} alt="" widths={[40, 80]} sizes="40px" class="h-full w-full object-contain" />
  </span>
  <span class="leading-tight">
    <span class={`block font-serif text-lg font-semibold ${isLight ? 'text-white' : 'text-maroon-900'}`}>
      UBF Shippensburg
    </span>
    <span class={`block text-[10px] font-semibold tracking-wider uppercase ${isLight ? 'text-gold-400' : 'text-gold-600'}`}>
      University Bible Fellowship
    </span>
  </span>
</a>
